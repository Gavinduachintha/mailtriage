# Google Cloud — enable Gmail API on the project
GMAIL_API_KEY=

# OAuth 2.0 Web client (API key alone cannot read your inbox)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Signs the encrypted session cookie after OAuth
SESSION_SECRET=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL (no ORM — raw SQL via pg)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/postgres

# Local Ollama (email triage + draft)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3
